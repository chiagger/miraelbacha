# Firebase web application configuration (public values).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Public portfolio URL, for the "Apri sito" link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only service account credentials. Never use NEXT_PUBLIC_ for these.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Authentication user UIDs allowed to administer this site.
# Comma-separated; deny all writes if empty.
ADMIN_UIDS=
